#
# Open loop commands - ignores input sensor
#

record(longout, "$(P)$(M)StepCnt") {
    field(DESC, "Step count to move")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))STEPCNT")
    field(VAL,  "0")
}

record(longout, "$(P)$(M)StepFreq") {
    field(DESC, "Step frequency")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))STEPFREQ")
    field(PINI, "YES")

    info(asyn:READBACK,"1")
}

record(bo, "$(P)$(M)OpenLoop") {
    field(DESC, "Open loop (use steps directly)")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))OPENLOOP")
    field(ZNAM, "Closed")
    field(ONAM, "Opened")
    field(VAL,  "0")  # start with closed loop
    field(PINI, "YES")
}

