    field(FRVL, "309")
    field(FRST, "CT005/AT001")
    field(FVVL, "357")
    field(FVST, "CT025/AT001")
    field(SXVL, "301")
    field(SXST, "CT001/AT002")
    field(SVVL, "313")
    field(SVST, "CT003/AT002")
    field(EIVL, "358")
    field(EIST, "CT025/AT002")
    field(NIVL, "307")
    field(NIST, "CT007/AT002")
    field(TEVL, "416")
