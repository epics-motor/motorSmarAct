  field(ZRVL, "300")
  field(ONVL, "312")
  field(TWVL, "302")
  field(THVL, "303")
  field(FRVL, "309")
  field(FVVL, "357")
  field(SXVL, "301")
  field(SVVL, "313")
  field(EIVL, "358")
  field(NIVL, "307")
  field(TEVL, "1")
  field(ZRST, "S")
  field(ONST, "SR")
  field(TWST, "SP")
  field(THST, "SC")
  field(FRST, "SR20")
  field(FVST, "M")
  field(SXST, "SD")
  field(SVST, "SR2")
