############################
# motor Record
# Since JOG is not supported by the driver yet, 0.0
# is a good value. However, 0.0 will fall back to VELO
# In other words: JVEL < 0 is a good value here
record(motor,"$(P)$(M)")
{
    field(DESC,"$(DESC)")
    field(EGU, "mm")
    field(DTYP,"asynMotor")
    field(OUT,"@asyn($(PORT),$(ADDR))")
    field(VELO,"$(VELO=1)")
    field(JVEL,"$(JVEL=-1)")
    field(ACCL,"$(ACCL=0)")
    field(JAR, "$(JAR=0)")
    field(MRES,"$(MRES=1.e-6)")
    field(ERES,"$(ERES=0)")
    field(PREC,"$(PREC=6)")
    field(EGU,"$(EGU=mm)")
    field(RDBL,"$(P)$(M)PosWhenDone")
    field(RRES,"1.0")
    field(URIP,"$(URIP=0)")
    field(RDBD,"$(RDBD=0.01)")
    field(SPDB,"$(SPDB=0.01)")
    field(ADEL,"$(ADEL=0.00001)")
    field(MDEL,"$(MDEL=0.00001)")
    field(RTRY,"$(RTRY=5)")
    field(RMOD,"$(RMOD=0)")
    field(DLY,"$(DLY=0.1)")
    field(FOFF,"$(FOFF=0)")
    field(NTM,"0")
    field(TWV,"$(TWV=1)")
    field(DLLM,"$(DLLM=0)")
    field(DHLM,"$(DHLM=0)")
}

record(ai, "$(P)$(M)PosWhenDone") {
    field(DTYP, "asynFloat64")
    field(DESC, "Position when done moving")
    field(INP,  "@asyn($(PORT),$(ADDR))MotorPosWhenDone")
    field(EGU,  "mm")
    field(PREC, "6")
    field(ASLO, "$(ASLO=0.000001)")
    field(ADEL, "$(RAWENCSTEP_ADEL=0.000001)")
    field(MDEL, "$(RAWENCSTEP_MDEL=0.000001)")
    field(SCAN, "I/O Intr")
}

record(mbbo, "$(P)$(M)SensPwrMode") {
    field(DESC, "Sensor Power Mode")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))SensorPowerMode")
    field(VAL,  "2")
    field(PINI, "RUNNING")
    field(ZRVL, "0")
    field(ONVL, "1")
    field(TWVL, "2")
    field(ZRST, "Disabled")
    field(ONST, "Enabled")
    field(TWST, "PowerSave")

    info(asyn:READBACK,"1")
}

# When sensor is disabled, update RBV only when motor has finished moving
# Do this by using PosWhenDone in RDBL + URIP
record(calcout, "$(P)$(M)#SetURIP" ){
    field(DESC, "Set URIP based on sensor mode")
    field(INPA, "$(P)$(M)SensPwrMode-RB CP")
    field(CALC, "A == 0")
    field(OUT,  "$(P)$(M).URIP PP")
    field(OOPT, "On Change")
}

# Sensor power save delay
# Value is saved in non-volatile memory
# read back what we have at the beginning
record(longout, "$(P)$(M)SensPwrSavDly") {
    field(DESC, "Sensor Power Save Delay")
    field(EGU,  "ms")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))SensorDelay")
    field(VAL,  "100")
    field(HOPR, "5000")
    field(LOPR, "0")

    info(asyn:READBACK,"1")
    info(asyn:INITIAL_READBACK,"1")
}

# Calibrate, even readback
record(bo, "$(P)$(M)Calibrate-Cmd") {
    field(DESC, "Calibration command")
    field(DTYP,"asynInt32")
    field(OUT, "@asyn($(PORT),$(ADDR),$(TIMEOUT))CAL")
    field(ZNAM, "Not calibrated")
    field(ONAM, "Calibrated")

    info(asyn:READBACK,"1")
    info(asyn:INITIAL_READBACK,"1")
}

record(longout, "$(P)$(M)MaxCtrlLFreq") {
    field(DESC, "MCL Frequency")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))MCLF")
    field(HOPR, "20000")
    field(LOPR, "50")
    field(EGU,  "Hz")

    info(asyn:READBACK, "1")
}

# hold time after positioning
# Use 2000000000 as a maximum value to simplify things
# and to avoid possible integer overflow in range checking.
# To be checked in the C code
record(longout, "$(P)$(M)HoldTime") {
    field(DESC, "hold time")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))HOLD")
    field(VAL,  "-1")
    field(PINI, "RUNNING")
    field(EGU,  "ms")
    field(HOPR, "2000000000")
    field(LOPR, "-1")

    info(asyn:READBACK, "1")
}

