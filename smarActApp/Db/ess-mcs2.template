# Positioner status word
record(longin, "$(P)$(M)-PSTAT") {
  field(DESC, "positioner status word")
  field(DTYP, "asynInt32")
  field(SCAN, "I/O Intr")
  field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))PSTAT")
}



# The position where the "motor" should be
# convert from nm into mm

record(ai, "$(P)$(M)-CommandedPos")
{
    field(DTYP, "asynFloat64")
    field(DESC, "CommandedPos")
    field(INP,  "@asyn($(PORT),$(ADDR))MOTOR_POSITION")
    field(EGU,  "mm")
    field(PREC, "6")
    field(ASLO, "$(ASLO=0.000001)")
    field(ADEL, "$(ADEL=0.000001)")
    field(MDEL, "$(MDEL=0.000001)")
    field(SCAN, "I/O Intr")
}

# The sensor. What the motor driver sees as encoder
# convert from nm into mm
record(ai, "$(P)$(M)-SensorPos")
{
    field(DTYP, "asynFloat64")
    field(DESC, "SensorPos")
    field(INP,  "@asyn($(PORT),$(ADDR))MOTOR_ENCODER_POSITION")
    field(EGU,  "mm")
    field(PREC, "6")
    field(ASLO, "$(ASLO=0.000001)")
    field(ADEL, "$(RAWENCSTEP_ADEL=0.000001)")
    field(MDEL, "$(RAWENCSTEP_MDEL=0.000001)")
    field(SCAN, "I/O Intr")
}

# When open loop, update this when DONE
record(ai, "$(P)$(M)-MotorPosWhenDone")
{
    field(DTYP, "asynFloat64")
    field(DESC, "MotorPosWhenDone")
    field(INP,  "@asyn($(PORT),$(ADDR))MotorPosWhenDone")
    field(EGU,  "mm")
    field(PREC, "6")
    field(ASLO, "$(ASLO=0.000001)")
    field(ADEL, "$(RAWENCSTEP_ADEL=0.000001)")
    field(MDEL, "$(RAWENCSTEP_MDEL=0.000001)")
    field(SCAN, "I/O Intr")
}

