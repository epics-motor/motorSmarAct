# Manual moves with steps
#
record(longout, "$(P)$(M)-STEPCNT") {
    field(DTYP,"asynInt32")
    field(DESC,"step count to move")
    field(EGU, "steps")
    field(OUT, "@asyn($(PORT),$(ADDR),$(TIMEOUT))STEPCNT")
    field(VAL, "0")
}

record(longout, "$(P)$(M)-STEPFREQ") {
    field(DTYP,"asynInt32")
