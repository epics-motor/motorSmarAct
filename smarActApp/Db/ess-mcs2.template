  field(TVST, "LC")
  field(TTST, "L")
  field(VAL,  "0")
  info(asyn:READBACK,"1")
  info(asyn:INITIAL_READBACK,"1")
}

record(longin, "$(P)$(M)-Freq-MCL-RB") {
    field(DESC,"MCL Frequency")
    field(DTYP,"asynInt32")
    field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))MCLF")
    field(SCAN, "I/O Intr")
    field(EGU, "Hz")
}

record(bi, "$(P)$(M)Ref-Sts") {
    field(DESC,"Reference")
